{
  "name": "LINE Alert - High Traffic",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3000/api/logs/stats",
        "options": {}
      },
      "name": "Get Log Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.data.uniqueIPs}}",
              "operation": "larger",
              "value2": 50
            }
          ]
        }
      },
      "name": "Check Threshold",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/webhook/line/push",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"userId\": \"YOUR_LINE_USER_ID\",\n  \"message\": \"⚠️ High Traffic Alert!\\n\\nUnique IPs: {{$json.data.uniqueIPs}}\\nTotal: {{$json.data.total}}\\nTime: {{$now.format('YYYY-MM-DD HH:mm:ss')}}\"\n}"
      },
      "name": "Send LINE Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [850, 200]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Get Log Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Log Stats": {
      "main": [
        [
          {
            "node": "Check Threshold",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Threshold": {
      "main": [
        [
          {
            "node": "Send LINE Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
