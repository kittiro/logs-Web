# Node.js Log API Configuration

# Server Port
PORT=3000

# Log Files Directory (relative to project root)
LOG_DIR=../storage/logs

# API Configuration
API_PREFIX=/api
CORS_ORIGIN=*

# Pagination
DEFAULT_LIMIT=100
MAX_LIMIT=1000

# LINE Messaging API
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
